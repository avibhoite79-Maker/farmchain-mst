# local = Hardhat node, mst = MST Testnet
VITE_NETWORK=mst
# Leave empty in development (the Vite proxy forwards /api to the backend on port 5000).
# Set to your hosted backend URL when you deploy the website.
VITE_API_URL=
# The address printed inside QR codes. Leave empty to use the address the site is opened on.
# Set it to your public https link (Vercel / ngrok) so printed QR codes always work.
VITE_PUBLIC_URL=
# Optional: block explorer used for the "verify on chain" link
VITE_EXPLORER_URL=https://testnet.mstscan.com
